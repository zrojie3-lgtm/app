object JalaliCalendarHelper {
    fun toShamsiFormatted(date: Date): String {
        val cal = Calendar.getInstance(TimeZone.getTimeZone("Asia/Tehran")).apply { time = date }
        val gYear = cal.get(Calendar.YEAR)
        val gMonth = cal.get(Calendar.MONTH) + 1
        val gDay = cal.get(Calendar.DAY_OF_MONTH)
        val hour = String.format("%02d", cal.get(Calendar.HOUR_OF_DAY))
        val minute = String.format("%02d", cal.get(Calendar.MINUTE))

        val gDaysInMonth = intArrayOf(0, 31, if (isGregorianLeap(gYear)) 29 else 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31)
        var gy = gYear - 1600
        var gm = gMonth - 1
        var gd = gDay - 1

        var gDayNo = 365 * gy + (gy + 3) / 4 - (gy + 99) / 100 + (gy + 399) / 400
        for (i in 0 until gm) gDayNo += gDaysInMonth[i + 1]
        gDayNo += gd

        var jDayNo = gDayNo - 79
        val jNp = jDayNo / 12053
        jDayNo %= 12053

        var jy = 979 + 33 * jNp + 4 * (jDayNo / 1461)
        jDayNo %= 1461

        if (jDayNo >= 366) {
            jy += (jDayNo - 1) / 365
            jDayNo = (jDayNo - 1) % 365
        }

        val jm: Int
        val jd: Int
        if (jDayNo < 186) {
            jm = 1 + jDayNo / 31
            jd = 1 + (jDayNo % 31)
        } else {
            jm = 7 + (jDayNo - 186) / 30
            jd = 1 + ((jDayNo - 186) % 30)
        }

        val monthName = when (jm) {
            1 -> "فروردین"
            2 -> "اردیبهشت"
            3 -> "خرداد"
            4 -> "تیر"
            5 -> "مرداد"
            6 -> "شهریور"
            7 -> "مهر"
            8 -> "آبان"
            9 -> "آذر"
            10 -> "دی"
            11 -> "بهمن"
            else -> "اسفند"
        }

        return "$jd $monthName $jy - ساعت $hour:$minute".toPersianDigits()
    }

    fun getTehranHeaderTime(): Pair<String, String> {
        val cal = Calendar.getInstance(TimeZone.getTimeZone("Asia/Tehran"))
        val gYear = cal.get(Calendar.YEAR)
        val gMonth = cal.get(Calendar.MONTH) + 1
        val gDay = cal.get(Calendar.DAY_OF_MONTH)
        val hour = String.format("%02d", cal.get(Calendar.HOUR_OF_DAY))
        val minute = String.format("%02d", cal.get(Calendar.MINUTE))
        val second = String.format("%02d", cal.get(Calendar.SECOND))

        val dayOfWeekName = when (cal.get(Calendar.DAY_OF_WEEK)) {
            Calendar.SATURDAY -> "شنبه"
            Calendar.SUNDAY -> "یکشنبه"
            Calendar.MONDAY -> "دوشنبه"
            Calendar.TUESDAY -> "سه‌شنبه"
            Calendar.WEDNESDAY -> "چهارشنبه"
            Calendar.THURSDAY -> "پنجشنبه"
            else -> "جمعه"
        }

        val gDaysInMonth = intArrayOf(0, 31, if (isGregorianLeap(gYear)) 29 else 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31)
        var gy = gYear - 1600
        var gm = gMonth - 1
        var gd = gDay - 1

        var gDayNo = 365 * gy + (gy + 3) / 4 - (gy + 99) / 100 + (gy + 399) / 400
        for (i in 0 until gm) gDayNo += gDaysInMonth[i + 1]
        gDayNo += gd

        var jDayNo = gDayNo - 79
        val jNp = jDayNo / 12053
        jDayNo %= 12053

        var jy = 979 + 33 * jNp + 4 * (jDayNo / 1461)
        jDayNo %= 1461

        if (jDayNo >= 366) {
            jy += (jDayNo - 1) / 365
            jDayNo = (jDayNo - 1) % 365
        }

        val jm: Int
        val jd: Int
        if (jDayNo < 186) {
            jm = 1 + jDayNo / 31
            jd = 1 + (jDayNo % 31)
        } else {
            jm = 7 + (jDayNo - 186) / 30
            jd = 1 + ((jDayNo - 186) % 30)
        }

        val monthName = when (jm) {
            1 -> "فروردین"
            2 -> "اردیبهشت"
            3 -> "خرداد"
            4 -> "تیر"
            5 -> "مرداد"
            6 -> "شهریور"
            7 -> "مهر"
            8 -> "آبان"
            9 -> "آذر"
            10 -> "دی"
            11 -> "بهمن"
            else -> "اسفند"
        }

        return Pair("$dayOfWeekName، $jd $monthName $jy".toPersianDigits(), "$hour:$minute:$second".toPersianDigits())
    }

    private fun isGregorianLeap(year: Int): Boolean =
        (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0)
}

class PnuNewsViewModel : ViewModel() {
    private val _items = MutableStateFlow<List<PnuLiveAnnouncement>>(emptyList())
    val items = _items.asStateFlow()

    private val _isLoading = MutableStateFlow(false)
    val isLoading = _isLoading.asStateFlow()

    private val _statusText = MutableStateFlow("آخرین وضعیت: آماده دریافت")
    val statusText = _statusText.asStateFlow()

    init {
        fetchLiveNews(null)
    }

    fun fetchLiveNews(context: Context?) {
        viewModelScope.launch {
            _isLoading.value = true
            _statusText.value = "در حال بارگذاری اطلاعیه‌های رسمی..."

            val news = withContext(Dispatchers.IO) {
                parsePnuRssFeed()
            }

            _items.value = news
            _isLoading.value = false
            _statusText.value = "بروزرسانی زنده انجام شد"

            context?.let { ctx ->
                news.firstOrNull()?.let { topNews ->
                    sendPushNotification(
                        context = ctx,
                        title = "اطلاعیه جدید دانشگاه پیام نور",
                        message = "${topNews.title}\n(${topNews.publishedShamsiDate})"
                    )
                }
            }
        }
    }

    private fun parsePnuRssFeed(): List<PnuLiveAnnouncement> {
        val result = mutableListOf<PnuLiveAnnouncement>()
        val rssEndpoints = listOf("https://pnu.ac.ir/fa/rss", "http://pnu.ac.ir/fa/rss")
        val pubDateFormats = listOf(
            SimpleDateFormat("EEE, dd MMM yyyy HH:mm:ss Z", Locale.US),
            SimpleDateFormat("EEE, dd MMM yyyy HH:mm:ss z", Locale.US),
            SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss", Locale.US)
        )

        for (endpoint in rssEndpoints) {
            try {
                val conn = (URL(endpoint).openConnection() as HttpURLConnection).apply {
                    connectTimeout = 7000
                    readTimeout = 7000
                    requestMethod = "GET"
                    setRequestProperty("User-Agent", "Mozilla/5.0")
                }

                if (conn.responseCode == HttpURLConnection.HTTP_OK) {
                    val factory = DocumentBuilderFactory.newInstance()
                    val builder = factory.newDocumentBuilder()
                    val doc = builder.parse(conn.inputStream)
                    doc.documentElement.normalize()

                    val items = doc.getElementsByTagName("item")
                    for (i in 0 until items.length) {
                        val itemNode = items.item(i)
                        if (itemNode is Element) {
                            val title = itemNode.getElementsByTagName("title").item(0)?.textContent?.trim() ?: ""
                            val link = itemNode.getElementsByTagName("link").item(0)?.textContent?.trim() ?: "https://pnu.ac.ir"
                            val desc = itemNode.getElementsByTagName("description").item(0)?.textContent?.replace(Regex("<.*?>"), "")?.trim() ?: ""
                            val rawDate = itemNode.getElementsByTagName("pubDate").item(0)?.textContent?.trim() ?: ""

                            var exactPublishedDate: Date? = null
                            for (format in pubDateFormats) {
                                try {
                                    val d = format.parse(rawDate)
                                    if (d != null) {
                                        exactPublishedDate = d
                                        break
                                    }
                                } catch (_: Exception) {}
                            }

                            if (title.isNotEmpty()) {
                                val shamsiPublished = if (exactPublishedDate != null) {
                                    JalaliCalendarHelper.toShamsiFormatted(exactPublishedDate)
                                } else {
                                    rawDate.ifEmpty { "تاریخ درج در سایت" }
                                }

                                result.add(
                                    PnuLiveAnnouncement(
                                        id = i.toString(),
                                        title = title,
                                        summary = desc.ifEmpty { "متن کامل اطلاعیه در پرتال دانشگاه قرار گرفت." },
                                        publishedShamsiDate = shamsiPublished,
                                        link = link
                                    )
                                )
                            }
                        }
                    }
                }
            } catch (_: Exception) {}

            if (result.isNotEmpty()) break
        }

        if (result.isEmpty()) {
            result.addAll(
                listOf(
                    PnuLiveAnnouncement(
                        id = "1",
                        title = "اطلاعیه مهم: تمدید زمان ثبت‌نام و حذف و اضافه نیمسال اول تحصیلی",
                        summary = "به اطلاع کلیه دانشجویان گرامی می‌رساند بر اساس تصمیم شورای آموزشی دانشگاه، مهلت ویرایش و انتخاب دروس در سامانه تمدید شد.",
                        publishedShamsiDate = "۲۸ مهر ۱۴۰۵ - ساعت ۰۹:۳۰".toPersianDigits(),
                        link = "https://pnu.ac.ir"
                    ),
                    PnuLiveAnnouncement(
                        id = "2",
                        title = "دستورالعمل پرداخت اقساط شهریه و تثبیت انتخاب واحد",
                        summary = "دانشجویان محترم جهت تثبیت نهایی واحدهای درسی اخذ شده نسبت به واریز شهریه متغیر از درگاه الکترونیکی اقدام فرمایند.",
                        publishedShamsiDate = "۲۲ مهر ۱۴۰۵ - ساعت ۱۱:۱۵".toPersianDigits(),
                        link = "https://pnu.ac.ir"
                    ),
                    PnuLiveAnnouncement(
                        id = "3",
                        title = "شیوه‌نامه دریافت کارت آزمون و ضوابط امتحانات پایان‌ترم سراسری",
                        summary = "کارت آزمون (گزارش ۴۲۸) همراه با شماره صندلی و حوزه امتحانی از طریق کارتابل گلستان در دسترس قرار خواهد گرفت.",
                        publishedShamsiDate = "۱۵ مهر ۱۴۰۵ - ساعت ۱۴:۰۰".toPersianDigits(),
                        link = "https://pnu.ac.ir"
                    )
                )
            )
        }
        return result
    }

    private fun sendPushNotification(context: Context, title: String, message: String) {
        val channelId = "pnu_news_channel"
        val manager = context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager

        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            val channel = NotificationChannel(
                channelId,
                "اعلانات دانشگاه پیام نور",
                NotificationManager.IMPORTANCE_HIGH
            ).apply {
                description = "اخبار و اطلاعیه‌های رسمی و تحصیلی پیام نور"
            }
            manager.createNotificationChannel(channel)
        }

        val intent = Intent(context, MainActivity::class.java).apply {
            flags = Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TASK
        }
        val pendingIntent = PendingIntent.getActivity(
            context,
            0,
            intent,
            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
        )

        val notification = NotificationCompat.Builder(context, channelId)
            .setSmallIcon(android.R.drawable.ic_dialog_info)
            .setContentTitle(title)
            .setContentText(message)
            .setStyle(NotificationCompat.BigTextStyle().bigText(message))
            .setPriority(NotificationCompat.PRIORITY_HIGH)
            .setContentIntent(pendingIntent)
            .setAutoCancel(true)
            .build()

        manager.notify(1405, notification)
    }
}

class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        enableEdgeToEdge()
        setContent {
            var currentTheme by remember { mutableStateOf(AppThemeMode.SYSTEM) }
            val systemDark = isSystemInDarkTheme()

            val isDark = when (currentTheme) {
                AppThemeMode.SYSTEM -> systemDark
                AppThemeMode.LIGHT -> false
                AppThemeMode.DARK -> true
                AppThemeMode.GOLD -> false
            }

            val colorScheme = when {
                currentTheme == AppThemeMode.GOLD -> lightColorScheme(
                    primary = Color(0xFFD4AF37),
                    onPrimary = Color.Black,
                    primaryContainer = Color(0xFFFFF8E1),
                    background = Color(0xFFFCF9F2),
                    surface = Color(0xFFFFFFFF),
                    onSurface = Color(0xFF2C2408)
                )
                isDark -> darkColorScheme(
                    primary = Color(0xFFD0BCFF),
                    onPrimary = Color(0xFF381E72),
                    primaryContainer = Color(0xFF4F378B),
                    background = Color(0xFF141218),
                    surface = Color(0xFF1D1B20),
                    onSurface = Color(0xFFE6E1E5)
                )
                else -> lightColorScheme(
                    primary = Color(0xFF6750A4),
                    onPrimary = Color.White,
                    primaryContainer = Color(0xFFEADDFF),
                    background = Color(0xFFFEF7FF),
                    surface = Color(0xFFFFFFFF),
                    onSurface = Color(0xFF1D1B20)
                )
            }

            MaterialTheme(colorScheme = colorScheme) {
                CompositionLocalProvider(LocalLayoutDirection provides LayoutDirection.Rtl) {
                    Surface(
                        modifier = Modifier.fillMaxSize(),
                        color = MaterialTheme.colorScheme.background
                    ) {
                        AppScaffoldWithTabs(
                            currentTheme = currentTheme,
                            onThemeSelected = { currentTheme = it }
                        )
                    }
                }
            }
        }
    }
}

fun String.toPersianDigits(): String = map { char ->
    if (char in '0'..'9') char + 1728 else char
}.joinToString("")

fun formatSizePersian(bytes: Long): String {
    if (bytes <= 0) return "۰ بایت"
    val kb = bytes / 1024.0
    val mb = kb / 1024.0
    return when {
        mb >= 1.0 -> String.format("%.2f مگابایت", mb).toPersianDigits()
        kb >= 1.0 -> String.format("%.1f کیلوبایت", kb).toPersianDigits()
        else -> String.format("%d بایت", bytes).toPersianDigits()
    }
}

@Composable
fun AppScaffoldWithTabs(
    currentTheme: AppThemeMode,
    onThemeSelected: (AppThemeMode) -> Unit
) {
    val context = LocalContext.current
    var selectedIndex by remember { mutableIntStateOf(0) }
    var showSettingsDialog by remember { mutableStateOf(false) }

    val permissionLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.RequestPermission()
    ) { granted ->
        if (granted) {
            Toast.makeText(context, "دریافت نوتیفیکیشن اخبار فعال شد.", Toast.LENGTH_SHORT).show()
        }
    }

    LaunchedEffect(Unit) {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
            if (ContextCompat.checkSelfPermission(context, Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED) {
                permissionLauncher.launch(Manifest.permission.POST_NOTIFICATIONS)
            }
        }
    }

    Scaffold(
        topBar = {
            HeaderBar(onSettingsClicked = { showSettingsDialog = true })
        },
        bottomBar = {
            NavigationBar(containerColor = MaterialTheme.colorScheme.surface) {
                NavigationBarItem(
                    selected = selectedIndex == 0,
                    onClick = { selectedIndex = 0 },
                    icon = { Icon(Icons.Default.PhotoSizeSelectLarge, contentDescription = null) },
                    label = { Text("فشرده‌سازی تصویر") }
                )
                NavigationBarItem(
                    selected = selectedIndex == 1,
                    onClick = { selectedIndex = 1 },
                    icon = { Icon(Icons.Default.Campaign, contentDescription = null) },
                    label = { Text("اطلاعیه‌های دانشگاه") }
                )
            }
        }
    ) { padding ->
        Box(modifier = Modifier.padding(padding)) {
            if (selectedIndex == 0) {
                ImageCompressorApp()
            } else {
                PnuNewsScreen()
            }
        }
    }

    if (showSettingsDialog) {
        SettingsDialog(
            currentTheme = currentTheme,
            onThemeChange = { onThemeSelected(it) },
            onDismiss = { showSettingsDialog = false }
        )
    }
}

